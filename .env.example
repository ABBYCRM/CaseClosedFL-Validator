NODE_ENV=development
PORT=8080
# Host-side default (npm run dev / migrate against `docker compose up -d db`).
# The validator Compose service overrides this to host `db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caseclosed_validator
ADMIN_SECRET=replace-with-at-least-24-random-characters
TOKEN_PEPPER=replace-with-at-least-24-random-characters

# Choose one reasoning provider. The TypeScript runtime remains the agent.
MODEL_PROVIDER=nvidia
EMBEDDING_PROVIDER=nvidia

# NVIDIA NIM / build.nvidia.com compatible endpoint
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIMENSIONS=2048

# OpenAI Platform / Responses API provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=2048

# Composio project key (ak_…). Never use a Connect consumer key (ck_…) here.
# ck_ keys are only for Connect MCP (x-consumer-api-key / connect.composio.dev).
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_USER_ID=caseclosedfl-validator
# Composio tool-router session allowlist. CSV is trimmed; empty omits `toolkits`.
# Session create sends { toolkits: { enable: [...] } } — not `enabled`.
# Valid slugs (operator-confirmed): tavily, exa, firecrawl, serpapi, browser_tool.
# `steel` is not a Composio toolkit; keep STEEL_API_KEY for the direct Steel fallback.
COMPOSIO_TOOLKITS=tavily,exa,firecrawl,serpapi,browser_tool

# Optional direct Steel fallback; Composio is preferred.
STEEL_API_KEY=
STEEL_BASE_URL=https://api.steel.dev/v1

# Optional direct provider fallbacks when Composio is missing/invalid/down.
# None of these are required at boot.
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPFLY_API_KEY=
SCREENSHOTONE_ACCESS_KEY=
SCREENSHOTONE_SECRET_KEY=

# Optional bounded OpenClaw gateway adapter.
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=

# Standalone HubSpot bridge.
# Required scopes: forms + contacts read + notes write/CRM objects notes.
# The bridge reads ONLY the two allowlisted forms and only writes NOTE objects.
HUBSPOT_SYNC_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
# Prefer exact GUIDs in production:
HUBSPOT_INITIAL_FORM_GUID=
HUBSPOT_EMAIL_FORM_GUID=
# Backward-compatible aliases:
HUBSPOT_INITIAL_FORM_ID=
HUBSPOT_EMAIL_FORM_ID=
# Or exact names; startup/list resolution must find exactly one active form per name:
HUBSPOT_INITIAL_FORM_NAME=
HUBSPOT_EMAIL_FORM_NAME=
HUBSPOT_SYNC_INTERVAL_MS=300000
HUBSPOT_SYNC_LOOKBACK_PAGES=4
HUBSPOT_SYNC_BATCH_SIZE=20

MAX_MODEL_CALLS=3
MAX_TOOL_CALLS=18
MAX_CYCLES=12
MAX_IDENTICAL_FAILURES=2
TOOL_TIMEOUT_MS=20000
HTTP_TIMEOUT_MS=12000
MAX_DOCUMENT_CHARS=60000
KNOWLEDGE_VERSION=2026.09.01
ENGINE_VERSION=1.3.1
