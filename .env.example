NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caseclosed_validator
ADMIN_SECRET=replace-with-at-least-24-random-characters
TOKEN_PEPPER=replace-with-at-least-24-random-characters

# Choose one reasoning provider. The TypeScript runtime remains the agent.
MODEL_PROVIDER=nvidia
EMBEDDING_PROVIDER=nvidia

# NVIDIA NIM / build.nvidia.com compatible endpoint
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIMENSIONS=2048

# OpenAI Platform / Responses API provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=2048

# Composio project key. Never commit a live value.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_USER_ID=caseclosedfl-validator
COMPOSIO_TOOLKITS=tavily,exa,serpapi,scrapingbee,steel

# Optional direct Steel fallback; Composio is preferred.
STEEL_API_KEY=
STEEL_BASE_URL=https://api.steel.dev/v1

# Optional bounded OpenClaw gateway adapter.
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=

MAX_MODEL_CALLS=3
MAX_TOOL_CALLS=18
MAX_CYCLES=12
MAX_IDENTICAL_FAILURES=2
TOOL_TIMEOUT_MS=20000
HTTP_TIMEOUT_MS=12000
MAX_DOCUMENT_CHARS=60000
KNOWLEDGE_VERSION=2026.09.01
ENGINE_VERSION=1.2.0
