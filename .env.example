NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caseclosed_validator
ADMIN_SECRET=replace-with-at-least-24-random-characters
TOKEN_PEPPER=replace-with-at-least-24-random-characters

MODEL_PROVIDER=bitdeer
EMBEDDING_PROVIDER=bitdeer
BITDEER_API_KEY=
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
BITDEER_REASONING_MODEL=zai-org/GLM-5
BITDEER_FORENSIC_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512
BITDEER_EMBED_MODEL=nvidia/Nemotron-3-Embed-8B-BF16
BITDEER_EMBED_DIMENSIONS=4096
BITDEER_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Optional OpenAI fallback. If used for embeddings, configure a 4096-dimensional compatible model/index or migrate the vector column accordingly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=4096

COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_USER_ID=caseclosedfl-validator
COMPOSIO_TOOLKITS=tavily,exa,firecrawl,serpapi,browser_tool

STEEL_API_KEY=
STEEL_BASE_URL=https://api.steel.dev/v1
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPFLY_API_KEY=
SCREENSHOTONE_ACCESS_KEY=
SCREENSHOTONE_SECRET_KEY=

OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=

HUBSPOT_SYNC_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_SYNC_MODE=auto
HUBSPOT_INITIAL_FORM_GUID=
HUBSPOT_EMAIL_FORM_GUID=
HUBSPOT_INITIAL_FORM_ID=
HUBSPOT_EMAIL_FORM_ID=
HUBSPOT_INITIAL_FORM_NAME=
HUBSPOT_EMAIL_FORM_NAME=
HUBSPOT_SYNC_INTERVAL_MS=300000
HUBSPOT_SYNC_LOOKBACK_PAGES=4
HUBSPOT_SYNC_LOOKBACK_DAYS=14
HUBSPOT_SYNC_BATCH_SIZE=20
HUBSPOT_NOTE_MAX_SCREENSHOTS=3

MAX_MODEL_CALLS=3
MAX_TOOL_CALLS=18
MAX_CYCLES=12
MAX_IDENTICAL_FAILURES=2
TOOL_TIMEOUT_MS=20000
HTTP_TIMEOUT_MS=12000
MAX_DOCUMENT_CHARS=60000
KNOWLEDGE_VERSION=2026.09.10
ENGINE_VERSION=1.4.1

# Optional free OSINT identity lookups (Holehe, PhoneInfoga, Mosint, h8mail).
# Off by default. When true, adapters run automatically during validation and
# soft-fail if a CLI is missing. The production Dockerfile bakes the four FREE
# CLIs onto PATH (DigitalOcean App Platform) — set OSINT_IDENTITY_ENABLED=true
# there; leave *_DOCKER_IMAGE empty (no docker-in-docker). Paid APIs are out of
# scope — do not add Hunter, HIBP, DeHashed, IntelX, or Epieos keys.
# See docs/OSINT_IDENTITY_SETUP.md.
OSINT_IDENTITY_ENABLED=false
OSINT_TIMEOUT_MS=25000
OSINT_DOCKER_IMAGE=
HOLEHE_BIN=holehe
HOLEHE_DOCKER_IMAGE=
HOLEHE_ONLY_USED=true
HOLEHE_TIMEOUT_MS=
PHONEINFOGA_BIN=phoneinfoga
PHONEINFOGA_DOCKER_IMAGE=
PHONEINFOGA_TIMEOUT_MS=
MOSINT_BIN=mosint
MOSINT_DOCKER_IMAGE=
MOSINT_TIMEOUT_MS=
H8MAIL_BIN=h8mail
H8MAIL_DOCKER_IMAGE=
H8MAIL_LOCAL_BREACH_PATH=
H8MAIL_TIMEOUT_MS=
